OPENAI_API_KEY=your_openai_api_key_here
MENTOR_API_KEY=your_mentor_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
